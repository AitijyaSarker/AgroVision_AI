# Copy to .env.local and fill in real values (never commit .env.local)

# MongoDB Atlas — required for Sign Up / Sign In
# The active user database is `test`; keep `/test` in the connection URI.
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/test?retryWrites=true&w=majority
MONGODB_URI=your_mongodb_atlas_connection_string
# Use `/test` as the database path in the URI (not `/agrovision`).

# Secret for login tokens (any long random string for local dev)
JWT_SECRET=your_random_jwt_secret_here

# Password recovery email via Resend (verify the sender/domain in Resend)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=AgroVision <no-reply@your-verified-domain.com>
PASSWORD_RESET_SECRET=your_separate_long_random_reset_secret

# Google Gemini — AI chatbot
GEMINI_API_KEY=your_gemini_api_key

# Optional
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_AI_SERVER_URL=
FRONTEND_URL=http://localhost:3000
